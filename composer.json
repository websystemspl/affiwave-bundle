{
    "name": "websystemspl/affiwave-bundle",
    "description": "Symfony bundle for SaaS apps integrating with the AffiWave affiliate platform: click attribution, S2S conversions for Stripe payments and partner coupons synced to Stripe promotion codes.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["affiwave", "affiliate", "stripe", "symfony", "bundle", "attribution"],
    "require": {
        "php": ">=8.2",
        "doctrine/doctrine-bundle": "^2.12 || ^3.0",
        "doctrine/orm": "^3.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "stripe/stripe-php": "^19.0 || ^20.0",
        "symfony/var-exporter": "^7.4 || ^8.0"
    },
    "suggest": {
        "stripe/stripe-php": "Required for the built-in Stripe gateway (partner coupons -> promotion codes, discount lookups)."
    },
    "autoload": {
        "psr-4": {
            "AffiWave\\Bundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AffiWave\\Bundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse src --level 6"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
